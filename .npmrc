; Silence the "N packages are looking for funding" notice on install
fund=false

; Hide the install-time audit report: the high-sev findings are the
; braces->chokidar dev-server chain, unfixable on eleventy 3 (fixed in
; eleventy 4 via chokidar 5) and unreachable in build/CI. Run `npm audit`
; on demand - it still works with this setting.
audit=false
